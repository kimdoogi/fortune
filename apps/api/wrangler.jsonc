{
  // app Worker: 프론트(Static Assets) + API (docs/15 §2, D-023)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fortune-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // 공개 주소는 app Worker 하나뿐 (docs/15 §2). 대표 주소 jumjip.app (D-085).
  // 옛 workers.dev 주소는 테스트 사용자 세션 때문에 당분간 열어 둔다
  "routes": [{ "pattern": "jumjip.app", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // IP당 하루 새 계정 수 (F14). "0" = 제한 없음 (테스트 기간에 꺼 둠, Turnstile을 켜면 다시 5로)
  "vars": { "ACCOUNTS_PER_IP": "0" },
  "services": [{ "binding": "READING", "service": "fortune-reading" }],
  "durable_objects": {
    "bindings": [
      { "name": "VILLAGE", "class_name": "VillageChannel", "script_name": "fortune-realtime" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fortune-prod",
      "database_id": "31931ef8-d32a-4095-bce1-aef32cd8e6fb",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "KV", "id": "b2a1497b66584178aa9e849443c6f8e5" }],
  // PII_KEY: 생년월일 암호화 (AES-GCM, base64 32바이트). TURNSTILE_SECRET은 위젯을 만든 뒤 추가 (F14)
  "secrets": { "required": ["WS_TOKEN_KEY", "PII_KEY"] }
}
