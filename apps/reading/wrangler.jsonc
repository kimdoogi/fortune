{
  // reading Worker: LLM 호출 전용, 공개 주소 없음 (docs/15 §6, D-022)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fortune-reading",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // AI Gateway를 AI 바인딩으로 거친다 (docs/15 §6). DB·KV 바인딩은 주지 않는다
  "ai": { "binding": "AI" },
  // fixture: 저장된 응답을 돌려준다 (비용 없이 개발). live: Anthropic 호출
  // ANTHROPIC_API_KEY는 secret (게이트웨이 BYOK를 쓰면 없어도 된다)
  // LLM_ROUTE direct: 게이트웨이를 거치지 않고 Anthropic에 바로 보낸다 (D-067). 게이트웨이 BYOK를 마치면 gateway로 바꾼다
  "vars": { "LLM_MODE": "live", "LLM_ROUTE": "direct", "AI_GATEWAY_ID": "default" }
}
